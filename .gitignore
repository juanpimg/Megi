# Rust / Cargo build artifacts
/target/
**/*.rs.bk
*.pdb

# Agent & Teamwork metadata (never tracked in repository)
/.agents/
.agents/

# Local specification cache (downloaded HTML/JSON specs)
/.cache/
.cache/

# Sparse WPT checkout (kept locally for inspection; html5lib-tests is tracked in tests/html5lib-tests).
# Everything under tests/wpt/ stays untracked EXCEPT the vendored conformance fixtures
# needed by `test_harness --summary`: CSS Syntax (specialized extractor) and the
# atob/base64 component suite (real JavaScript through the offline runner). The dom/events,
# dom/nodes and url directories are vendored as kind="skip" while their engine APIs are
# incomplete; their provenance stays explicit in MANIFEST.json / NOTICE.md.
/tests/wpt/*
!/tests/wpt/css/
/tests/wpt/css/*
!/tests/wpt/css/css-syntax/
!/tests/wpt/dom/
!/tests/wpt/fetch/
!/tests/wpt/html/
!/tests/wpt/url/
# SHA-pinned provenance + gate metadata (tracked; everything else under tests/wpt/ stays local).
!/tests/wpt/WPT-REVISION.json
!/tests/wpt/MANIFEST.json
!/tests/wpt/NOTICE.md
!/tests/wpt/baseline.json
!/tests/wpt/allowlist.toml
/tests/html5lib-tests/.git/

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Fuzzing harness (fuzz/ is a standalone cargo-fuzz workspace; only the seed corpus is tracked)
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock

# Superpowers planning workspace (specs/plans live in docs/superpowers/ and are tracked)
/.superpowers/

# Local tooling state (not shared)
/.code-review-graph/
/docs/status/badge-lcov.svg
