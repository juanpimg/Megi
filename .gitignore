# Rust / Cargo build artifacts
/target/
**/*.rs.bk
*.pdb

# Agent & Teamwork metadata (never tracked in repository)
/.agents/
.agents/

# Local specification cache (downloaded HTML/JSON specs)
/.cache/
.cache/

# Sparse WPT checkout (kept locally for inspection; html5lib-tests is tracked in tests/html5lib-tests).
# Everything under tests/wpt/ stays untracked EXCEPT the vendored CSS Syntax conformance fixtures,
# which are needed for `cargo test -p test_harness` / `test_harness --summary` to run offline.
/tests/wpt/*
!/tests/wpt/css/
/tests/wpt/css/*
!/tests/wpt/css/css-syntax/
/tests/html5lib-tests/.git/

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Fuzzing harness (fuzz/ is a standalone cargo-fuzz workspace; only the seed corpus is tracked)
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock
